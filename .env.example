# ============================================================
#  .env.example — copy to .env for local dev, NEVER commit .env
#  On Render: set these in Dashboard → Environment Variables
# ============================================================

# PostgreSQL (Render sets this automatically when you add a DB)
DATABASE_URL=postgresql://user:password@host:5432/dbname

# Zerodha Kite — https://developers.kite.trade/apps
# Set Redirect URL to: https://your-backend.onrender.com/kite/callback
ZERODHA_API_KEY=your_kite_api_key
ZERODHA_API_SECRET=your_kite_api_secret

# Generate once:  python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=your_fernet_key_here

# JWT
SECRET_KEY=your_jwt_secret_min_32_chars

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# CORS — your Cloudflare Pages URL (comma-separated)
ALLOWED_ORIGINS=https://your-app.pages.dev

# App
PORT=8000
EXCEL_PATH=./backend/data/trading_bull.xlsx
