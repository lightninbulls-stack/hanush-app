{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "hanush-app",
  "main": "./worker/index.js",
  "compatibility_date": "2026-04-08",
  "keep_vars": true,
  "observability": {
    "enabled": true
  },
  "vars": {
  "BACKEND_BASE_URL": "https://hanush-backend-service1.onrender.com"
},
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "lightninbull-watchlist",
      "database_id": "b4a4eadf-699c-411b-a2b3-b4882896abd7",
      "migrations_dir": "./migrations"
    }
  ]
}
